{
  "manifest_version": 3,
  "name": "コメントシーク for YouTube Live",
  "version": "1.0.3",
  "description": "YouTubeライブ配信アーカイブのチャットリプレイに、各コメントの少し前へジャンプするボタンを追加します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/live_chat_replay*"],
      "js": ["chat.js"],
      "css": ["chat.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["player.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
